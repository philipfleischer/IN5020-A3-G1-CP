<mxCell id="c35" value="hopp 2: fra 18 er 23 bare 5 unna → rad 3 → 22&lt;br&gt;hopp 3: fra 22 er 23 bare 1 unna → rad 1 → 25" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5B6573;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="840.0" y="180.0" width="330.0" height="50.0" as="geometry"/></mxCell>
<mxCell id="c36" value="Gjenstående avstand: 23 → 5 → 1 → funnet hos 25, og raden synker 5 → 3 → 1. Raden synker for hvert hopp, så det trengs aldri mer enn m hopp. Med N noder er gjennomsnittet omtrent ½ · log2(N) hopp, som er det vi måler." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5B6573;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;align=left;verticalAlign=middle;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30.0" y="320.0" width="1060.0" height="70.0" as="geometry"/></mxCell>
