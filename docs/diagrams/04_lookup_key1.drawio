<mxCell id="c29" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;key 1:4 Node 1:5 hop count: 3, route: Node 4 Node 3 Node 1&lt;/font&gt;&lt;br&gt;&lt;font face=&#x27;Courier New&#x27;&gt;key 2:0 Node 4:1 hop count: 1, route: Node 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5B6573;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F8FA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640.0" y="400.0" width="450.0" height="92.0" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;font color=&#x27;#5B6573&#x27;&gt;Stiplet pil: key 1 (4) lagres hos successor(4) = Node 1 (5). Key 2 (0) ligger allerede hos startnoden, så hop count = 1.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#5B6573;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=13;fontColor=#1F2933;fontFamily=Helvetica;align=left;verticalAlign=middle;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="640.0" y="505.0" width="450.0" height="60.0" as="geometry"/></mxCell>
